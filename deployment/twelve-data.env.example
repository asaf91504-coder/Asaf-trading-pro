# TEMPLATE ONLY. Do not source into production or commit real credentials.
# Keep these off until the commercial agreement is confirmed.
ASAF_MARKET_ENABLED=false
ASAF_MARKET_DISPLAY_LICENSE_CONFIRMED=false
ASAF_MARKET_PUBLIC_LICENSE_CONFIRMED=false
ASAF_MARKET_AI_LICENSE_CONFIRMED=false
TWELVE_DATA_API_KEY=
# Explicit US scanner symbols, up to 1,000. Or use the dated us1000 preset.
ASAF_SCANNER_UNIVERSE=
ASAF_MARKET_ALLOWED_SYMBOLS=
# Explicit provider delay in minutes. Leave blank until confirmed.
ASAF_MARKET_DELAY_MINUTES=
ASAF_MARKET_INTERVALS=1min,5min,15min,30min,1h,1day,1week
ASAF_MARKET_HISTORY_BARS=500
# Shared provider credits, not customer AI credits. Set to contracted budget.
ASAF_MARKET_REQUESTS_PER_MINUTE=8
ASAF_MARKET_REQUESTS_PER_DAY=800
# unconfirmed | partial | consolidated; set only from written provider scope.
ASAF_MARKET_VOLUME_COVERAGE=unconfirmed
# Optional /statistics remains off; each request reserves 50 provider credits.
ASAF_MARKET_FUNDAMENTALS_ENABLED=false

# Scanner company size and consolidated previous-session volume.
# Statistics costs 50 credits per company and is cached for 24 hours.
# 50 stocks: 2,500 company credits/day + 800 credits/day for 8 daily
# scanner cycles (two series/stock); leave capacity for charts and chat.
# Set budgets only within the connected account limits.
ASAF_SCANNER_DAILY_VOLUME_ENABLED=false

# To select 1,000 US stock candidates while retaining explicitly listed symbols:
# ASAF_SCANNER_UNIVERSE=us1000
# Provider coverage is checked by actual requests; no plan is changed by this flag.
# Cold load with company statistics + two daily series: 52,000 API credits.
# At 60 credits/minute a cold group holds one stock: ~1,000 minute ticks.
# At 610 credits/minute it holds ten stocks: ~100 minute ticks.
# The queue resumes after quota pauses; it never restarts an unfinished cycle.
